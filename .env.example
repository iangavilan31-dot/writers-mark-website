# ─── Stripe ──────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
# Get from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ─── Cal.com ─────────────────────────────────────────────────────────
# Get from: https://cal.com/settings/developer
CAL_API_KEY=cal_YOUR_KEY_HERE
CAL_WEBHOOK_SECRET=YOUR_RANDOM_32_CHAR_SECRET
# Your Cal.com username (the slug in your cal.com/username URLs)
CAL_USERNAME=the-writers-mark

# ─── Dropbox Sign (HelloSign) ────────────────────────────────────────
# Get from: https://app.hellosign.com/api/reference
DROPBOX_SIGN_API_KEY=YOUR_DROPBOX_SIGN_API_KEY
# Get from: Dropbox Sign → Templates → your template → Template ID
DROPBOX_SIGN_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE

# ─── Resend (Email) ──────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=bookings@thewritersmark.us

# ─── Supabase ────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# ─── Sanity CMS ──────────────────────────────────────────────────────
# Get from: https://sanity.io/manage → your project → API → Tokens
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR_SANITY_PROJECT_ID
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=skYOUR_SANITY_READ_TOKEN

# ─── Business Settings ───────────────────────────────────────────────
# Owner email — receives booking notifications and countersign requests
OWNER_EMAIL=owner@thewritersmark.us
OWNER_NAME=The Writer's Mark, LLC
# Production site URL — no trailing slash
SITE_URL=https://thewritersmark.us

# ─── Optional ────────────────────────────────────────────────────────
# Admin page password (simple password protection for /admin/* routes)
ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD_HERE
